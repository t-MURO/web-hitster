# Public HTTPS address configured in your Cloudflare Tunnel.
PUBLIC_BASE_URL=https://music.example.com

# Create a Spotify Developer app and register this exact callback:
# https://music.example.com/callback
SPOTIFY_CLIENT_ID=replace-with-your-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-client-secret
SPOTIFY_REDIRECT_URI=https://music.example.com/callback

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

COOKIE_SECURE=true
DEMO_MODE=false
HOST_PORT=4317
PORT=4317
DECK_SIZE=100
WINNING_TIMELINE_SIZE=10
DISCONNECT_GRACE_MS=120000

# The Docker image provides both tools. Override only for a native install.
YOUTUBE_DOWNLOADER_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
AUDIO_TEMP_ROOT=/tmp/music-timeline-audio
AUDIO_BITRATE_KBPS=96
AUDIO_PREPARATION_CONCURRENCY=2
