# Public HTTPS address configured in your Cloudflare Tunnel.
PUBLIC_BASE_URL=https://music.example.com

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

COOKIE_SECURE=true
DEMO_MODE=false
HOST_PORT=4317
PORT=4317
DECK_SIZE=50
WINNING_TIMELINE_SIZE=10
DISCONNECT_GRACE_MS=120000
